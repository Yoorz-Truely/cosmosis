geometry @tower "Tower" {
  nodes {
    node @in group-input
    node @stack group "Stack Up" {
      node-tree @stack-up
      geometry @in.base
      count 6
      gap 20cm
    }
    node @out group-output { tower-out @stack.stacked }
  }
  is-modifier
  input @base geometry "Base"
  output @tower-out geometry "Tower"
}
