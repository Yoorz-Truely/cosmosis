object @lamp "Lamp" {
  data light @lamp-light
  location [2m 0m 3m]
}

object @ball "Ball" {
  data mesh @ball-mesh
  track @moves "Moves" {
    strip @hop-twice "Hop" {
      blend-type add
      frame-start 1
      action @hop slot=@ball
      repeat 2
    }
  }
}

mesh @ball-mesh "Ball" { primitive uv-sphere radius=25cm }

object @dial "Dial" { rotation-euler [0deg 0deg 45deg] }

object @dial-light "Dial Light" { data light @dial-lamp }
