component @rig "Rig" {
  object @rig "Rig" {
    data armature @rig-bones
    bone @spine "Spine" {
      constraint @reach kinematic "IK" {
        target @lid
        chain-count 2
      }
      rotation-mode xyz
    }
  }
  armature @rig-bones "Rig" {
    bone @spine "Spine" {
      head [0m 0m 0m]
      tail [0m 0m 1m]
    }
    bone @neck "Neck" {
      parent @spine
      use-connect
      head [0m 0m 1m]
      tail [0m 0.1m 1.3m]
      roll 5deg
    }
  }
}
