geometry @stack "Stack" {
  is-modifier
  input @geometry geometry "Geometry"
  input @limit float "Limit" {
    min-value -inf
    max-value inf
    default-value nan
  }
  output @out-geometry geometry "Geometry"
  nodes {
    node @in group-input
    node @out group-output { out-geometry @in.geometry }
  }
}
