object @point "Point" {
  location [3m 0m 3m]
  data light @point-light
}

light @point-light "Point" {
  type point
  energy 800W
  color [1 0.85 0.7]
  shadow-soft-size 0.25m
}

object @sun "Sun" {
  rotation-euler [45deg 0deg -30deg]
  data light @sun-light
}

light @sun-light "Sun" {
  type sun
  energy 2.5
  angle 0.5deg
}

object @spot "Spot" {
  location [-3m -3m 4m]
  rotation-euler [45deg 0deg -45deg]
  data light @spot-light
}

light @spot-light "Spot" {
  type spot
  energy 1500W
  spot-size 40deg
  spot-blend 0.2
}

object @area "Area" {
  location [0m 3m 3m]
  rotation-euler [-45deg 0deg 0deg]
  data light @area-light
}

light @area-light "Area" {
  type area
  shape disk
  size 1.5m
  energy 300W
}
