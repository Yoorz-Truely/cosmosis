object @wide "Wide" {
  location [8m -8m 4m]
  rotation-euler [70deg 0deg 45deg]
  data camera @wide-lens
}

camera @wide-lens "Wide" {
  lens 24mm
}

object @close "Close" {
  location [2m -2m 1.5m]
  rotation-euler [85deg 0deg 45deg]
  data camera @close-lens
}

camera @close-lens "Close" {
  lens 105mm
  clip-start 0.05m
  clip-end 50m
}
